+// moe_mm3: fused MiniMax-M3 MoE decode ops (see kernels/moe_mm3.metal).
+// Args layout must match moe_mm3_args in the .metal file exactly.
+struct ggml_metal_kargs_moe_mm3 {
+    int32_t n_embd;
+    int32_t n_ff;
+    int32_t k;
+    int32_t n_tokens;
+    float   alpha;
+    float   limit;
+};
+
+int ggml_metal_op_moe_mm3_gu(ggml_metal_op_t ctx, int idx) {
+    ggml_tensor * op = ctx->node(idx);
+
+    ggml_metal_library_t lib = ctx->lib;
+    ggml_metal_encoder_t enc = ctx->enc;
+
+    // src0 = gate [n_embd, n_ff, n_exp], src1 = up (same), src2 = x [n_embd, T], src3 = ids [k, T]
+    GGML_ASSERT(op->src[3]->type == GGML_TYPE_I32);
+    GGML_ASSERT(ggml_is_contiguous(op->src[0]));
+    GGML_ASSERT(ggml_is_contiguous(op->src[1]));
+    // any T: decode (T == 1) and verify windows (T > 1) share this path
+
+    const int32_t n_embd = (int32_t) op->src[0]->ne[0];
+    const int32_t n_ff   = (int32_t) op->src[0]->ne[1];
+    const int32_t k      = (int32_t) op->ne[1];
+    const int32_t n_tokens = (int32_t) op->ne[2];
+
+    float alpha, limit;
+    memcpy(&alpha, &op->op_params[0], sizeof(float));
+    memcpy(&limit, &op->op_params[1], sizeof(float));
+
+    ggml_metal_kargs_moe_mm3 args = { n_embd, n_ff, k, n_tokens, alpha, limit };
+
+    auto pipeline = ggml_metal_library_get_pipeline_moe_mm3_gu(lib, op);
+
+    ggml_metal_encoder_set_pipeline(enc, pipeline);
+    ggml_metal_encoder_set_bytes   (enc, &args, sizeof(args), 0);
+    ggml_metal_encoder_set_buffer  (enc, ggml_metal_get_buffer_id(op->src[2]), 1); // x
+    ggml_metal_encoder_set_buffer  (enc, ggml_metal_get_buffer_id(op->src[0]), 2); // gate
+    ggml_metal_encoder_set_buffer  (enc, ggml_metal_get_buffer_id(op->src[1]), 3); // up
+    ggml_metal_encoder_set_buffer  (enc, ggml_metal_get_buffer_id(op->src[3]), 4); // ids
+    ggml_metal_encoder_set_buffer  (enc, ggml_metal_get_buffer_id(op),        5); // hh (dst)
+
+    const int32_t n_exp = (int32_t) op->src[0]->ne[2];
+    const bool em = n_tokens > 1 && n_tokens * k <= 128 && (n_ff % 8) == 0;
+    ggml_metal_encoder_dispatch_threadgroups(enc, em ? (n_exp*n_ff)/8 : (n_tokens*k*n_ff)/8, 1, 1, 256, 1, 1);
+
+    return 1;
+}

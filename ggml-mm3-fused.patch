+    snprintf(name, 256, "kernel_moe_mm3_down_sum%s", mm3_dsfx);
+
+    ggml_metal_pipeline_with_params res = ggml_metal_library_get_pipeline(lib, name);
+    if (!res.pipeline) {
+        res = ggml_metal_library_compile_pipeline(lib, name, name, nullptr);
+    }
+
+    res.smem = GGML_PAD((size_t) op->src[0]->ne[0] * sizeof(float), 16); // staged hh[e]
+
+    return res;
+}

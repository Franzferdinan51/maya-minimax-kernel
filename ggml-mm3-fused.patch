+ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_moe_mm3_gu(ggml_metal_library_t lib, const ggml_tensor * op) {
+    char name[256];
+    const ggml_type mm3_tg = op->src[0]->type;
+    const ggml_type mm3_tu = op->src[1]->type;
+    const char * mm3_sfx =
+        mm3_tg == GGML_TYPE_F32 ? "_f32" :
+        (mm3_tg == GGML_TYPE_IQ2_XXS && mm3_tu == GGML_TYPE_IQ2_XXS) ? "_iq2" :
+        (mm3_tg == GGML_TYPE_IQ2_XXS && mm3_tu == GGML_TYPE_IQ1_S)  ? "_iq2_iq1" :
+        (mm3_tg == GGML_TYPE_IQ1_S  && mm3_tu == GGML_TYPE_IQ2_XXS) ? "_iq1_iq2" : "";
+    snprintf(name, 256, "kernel_moe_mm3_gate_up_swiglu%s", mm3_sfx);
+
+    ggml_metal_pipeline_with_params res = ggml_metal_library_get_pipeline(lib, name);
+    if (!res.pipeline) {
+        res = ggml_metal_library_compile_pipeline(lib, name, name, nullptr);
+    }
+
+    res.smem = GGML_PAD((size_t) op->src[0]->ne[0] * sizeof(float), 16); // staged x
+
+    return res;
+}
+
+ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_moe_mm3_down(ggml_metal_library_t lib, const ggml_tensor * op) {

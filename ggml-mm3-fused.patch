+
+// ggml_compute_forward_moe_mm3_gu / ggml_compute_forward_moe_mm3_down
+//
+// reference implementations of the fused MiniMax-M3 MoE ops; the Metal
+// kernels are the fast path, these exist so that the CPU backend can serve
+// as the parity oracle. only F32 and IQ1_S expert weights are supported.
+
+static float ggml_moe_mm3_swiglu_oai(float g, float u, float alpha, float limit) {
+    g = fminf(g, limit);
+    u = fmaxf(-limit, fminf(u, limit));
+
+    return g/(1.0f + expf(-alpha*g)) * (u + 1.0f);
+}
+
+// returns a pointer to the n = w->ne[0] floats of row r of expert e of w;
+// for GGML_TYPE_IQ1_S the row is dequantized into scratch first
+static const float * ggml_moe_mm3_row_f32(
+        const struct ggml_tensor * w,
+        int64_t e,
+        int64_t r,
+        float * scratch) {
+    const char * row = (const char *) w->data + e*w->nb[2] + r*w->nb[1];
+
+    if (w->type == GGML_TYPE_F32) {
+        return (const float *) row;
+    }
+
+    if (w->type == GGML_TYPE_IQ2_XXS) {
+        dequantize_row_iq2_xxs((const block_iq2_xxs *) row, scratch, w->ne[0]);
+        return scratch;
+    }
+
+    GGML_ASSERT(w->type == GGML_TYPE_IQ1_S);
+    dequantize_row_iq1_s((const block_iq1_s *) row, scratch, w->ne[0]);
+
+    return scratch;
+}
+
+static float ggml_moe_mm3_dot_strided(const float * row, const char * vec, size_t vec_nb, int64_t n) {
+    float sum = 0.0f;
+
+    for (int64_t i = 0; i < n; ++i) {
+        sum += row[i] * (*(const float *) (vec + i*vec_nb));
+    }
+
+    return sum;
+}
+
+static void ggml_compute_forward_moe_mm3_gu(
+        const struct ggml_compute_params * params,
+              struct ggml_tensor * dst) {
+
+    const struct ggml_tensor * gate = dst->src[0];
+    const struct ggml_tensor * up   = dst->src[1];
+    const struct ggml_tensor * x    = dst->src[2];
+    const struct ggml_tensor * ids  = dst->src[3];
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    GGML_ASSERT(x->type    == GGML_TYPE_F32);
+    GGML_ASSERT(ids->type  == GGML_TYPE_I32);
+    GGML_ASSERT(dst->type  == GGML_TYPE_F32);
+
+    if ((gate->type != GGML_TYPE_F32 && gate->type != GGML_TYPE_IQ1_S && gate->type != GGML_TYPE_IQ2_XXS) ||
+        (up->type   != GGML_TYPE_F32 && up->type   != GGML_TYPE_IQ1_S && up->type   != GGML_TYPE_IQ2_XXS)) {
+        GGML_ABORT("unsupported weight type for GGML_OP_MOE_MM3_GU: %s/%s",
+                   ggml_type_name(gate->type), ggml_type_name(up->type));
+    }
+
+    // rows must be contiguous within a row
+    GGML_ASSERT(gate->nb[0] == ggml_type_size(gate->type));
+    GGML_ASSERT(up->nb[0]   == ggml_type_size(up->type));
+
+    const float alpha = ((const float *) dst->op_params)[0];
+    const float limit = ((const float *) dst->op_params)[1];
+
+    const int64_t n_embd = gate->ne[0];
+    const int64_t n_ff   = gate->ne[1];
+    const int64_t k      = ids->ne[0];
+    const int64_t n_tok  = x->ne[1];
+
+    float * scratch = NULL;
+
+    if (gate->type == GGML_TYPE_IQ1_S) {
+        scratch = (float *) malloc(n_embd*sizeof(float));
+        GGML_ASSERT(scratch != NULL);
+    }
+
+    // one work unit per (token, expert slot) pair; a unit computes n_ff outputs
+    const int64_t nr = n_tok*k;
+
+    for (int64_t ir = ith; ir < nr; ir += nth) {
+        const int64_t t = ir/k;
+        const int64_t s = ir%k;
+
+        const int32_t e = *(const int32_t *) ((const char *) ids->data + s*ids->nb[0] + t*ids->nb[1]);
+
+        const char * x_col   = (const char *) x->data + t*x->nb[1];
+        char       * dst_out = (char *) dst->data + s*dst->nb[1] + t*dst->nb[2];
+
+        for (int64_t r = 0; r < n_ff; ++r) {
+            const float g = ggml_moe_mm3_dot_strided(ggml_moe_mm3_row_f32(gate, e, r, scratch), x_col, x->nb[0], n_embd);
+            const float u = ggml_moe_mm3_dot_strided(ggml_moe_mm3_row_f32(up,   e, r, scratch), x_col, x->nb[0], n_embd);
+
+            *(float *) (dst_out + r*dst->nb[0]) = ggml_moe_mm3_swiglu_oai(g, u, alpha, limit);
+        }
+    }
+
+    free(scratch);
+}
+
+static void ggml_compute_forward_moe_mm3_down(
+        const struct ggml_compute_params * params,
+              struct ggml_tensor * dst) {
+
+    const struct ggml_tensor * down = dst->src[0];
+    const struct ggml_tensor * hh   = dst->src[1];
+    const struct ggml_tensor * ids  = dst->src[2];
+    const struct ggml_tensor * wts  = dst->src[3];
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    GGML_ASSERT(hh->type  == GGML_TYPE_F32);
+    GGML_ASSERT(ids->type == GGML_TYPE_I32);
+    GGML_ASSERT(wts->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+
+    if (down->type != GGML_TYPE_F32 && down->type != GGML_TYPE_IQ1_S && down->type != GGML_TYPE_IQ2_XXS) {
+        GGML_ABORT("unsupported weight type for GGML_OP_MOE_MM3_DOWN: %s", ggml_type_name(down->type));
+    }
+
+    // rows must be contiguous within a row
+    GGML_ASSERT(down->nb[0] == ggml_type_size(down->type));
+
+    const int64_t n_ff   = down->ne[0];
+    const int64_t n_embd = down->ne[1];
+    const int64_t k      = ids->ne[0];
+    const int64_t n_tok  = hh->ne[2];
+
+    float * scratch = NULL;
+
+    if (down->type == GGML_TYPE_IQ1_S) {
+        scratch = (float *) malloc(n_ff*sizeof(float));
+        GGML_ASSERT(scratch != NULL);
+    }
+
+    // one work unit per (token, output row) pair
+    const int64_t nr = n_tok*n_embd;
+
+    for (int64_t ir = ith; ir < nr; ir += nth) {
+        const int64_t t = ir/n_embd;
+        const int64_t j = ir%n_embd;
+
+        float acc = 0.0f;
+
+        for (int64_t s = 0; s < k; ++s) {
+            const int32_t e = *(const int32_t *) ((const char *) ids->data + s*ids->nb[0] + t*ids->nb[1]);
+            const float   w = *(const float *)   ((const char *) wts->data + s*wts->nb[0] + t*wts->nb[1]);
+
+            const char * hh_col = (const char *) hh->data + s*hh->nb[1] + t*hh->nb[2];
+
+            acc += w * ggml_moe_mm3_dot_strided(ggml_moe_mm3_row_f32(down, e, j, scratch), hh_col, hh->nb[0], n_ff);
+        }
+
+        *(float *) ((char *) dst->data + j*dst->nb[0] + t*dst->nb[1]) = acc;
+    }
+
+    free(scratch);
+}

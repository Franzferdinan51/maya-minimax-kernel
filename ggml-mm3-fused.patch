+// ggml_moe_mm3_gu / ggml_moe_mm3_down
+
+struct ggml_tensor * ggml_moe_mm3_gu(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * gate,
+        struct ggml_tensor  * up,
+        struct ggml_tensor  * x,
+        struct ggml_tensor  * ids,
+        float alpha,
+        float limit) {
+    GGML_ASSERT(!ggml_is_transposed(gate) && !ggml_is_transposed(up));
+    GGML_ASSERT(ids->type == GGML_TYPE_I32);
+    GGML_ASSERT(gate->ne[0] == x->ne[0]);          // n_embd
+    GGML_ASSERT(gate->ne[1] == up->ne[1]);         // n_ff
+    GGML_ASSERT(gate->ne[2] == up->ne[2]);         // n_exp
+    GGML_ASSERT(ids->ne[1] == x->ne[1]);           // one expert list per token
+
+    const int64_t ne[4] = { gate->ne[1], ids->ne[0], x->ne[1], 1 };
+    struct ggml_tensor * result = ggml_new_tensor(ctx, GGML_TYPE_F32, 4, ne);
+
+    result->op     = GGML_OP_MOE_MM3_GU;
+    result->src[0] = gate;
+    result->src[1] = up;
+    result->src[2] = x;
+    result->src[3] = ids;
+    ((float *) result->op_params)[0] = alpha;
+    ((float *) result->op_params)[1] = limit;
+
+    return result;
+}
+
+struct ggml_tensor * ggml_moe_mm3_down(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * down,
+        struct ggml_tensor  * hh,
+        struct ggml_tensor  * ids,
+        struct ggml_tensor  * wts) {
+    GGML_ASSERT(!ggml_is_transposed(down));
+    GGML_ASSERT(ids->type == GGML_TYPE_I32);
+    GGML_ASSERT(wts->type == GGML_TYPE_F32);
+    GGML_ASSERT(down->ne[0] == hh->ne[0]);         // n_ff
+    GGML_ASSERT(hh->ne[1] == ids->ne[0]);          // k
+    GGML_ASSERT(wts->ne[0] == ids->ne[0] && wts->ne[1] == ids->ne[1]);
+
+    const int64_t ne[4] = { down->ne[1], hh->ne[2], 1, 1 };
+    struct ggml_tensor * result = ggml_new_tensor(ctx, GGML_TYPE_F32, 4, ne);
+
+    result->op     = GGML_OP_MOE_MM3_DOWN;
+    result->src[0] = down;
+    result->src[1] = hh;
+    result->src[2] = ids;
+    result->src[3] = wts;
+
+    return result;
+}
